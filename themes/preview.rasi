/**
 * ROFI Color Theme
 *
 * Fullscreen theme with switchable PREVIEW option.
 * 
 * User: Dave Davenport
 * Copyright: Dave Davenport
 * modified by: Razigli
 */

* {
	background-color: transparent;
	text-color:       white;
	font: "Ubuntu 16";
}

window {
	background-color: #000000cc;
	children: [ wrap, listview-split];
	padding: 10px;
	spacing: 10px;
	border: 4px;
	width: 1100px;
	border-radius: 20px;
	border-color: #ff6767;
}


/** We add an extra child to this if PREVIEW=true */
listview-split {
  orientation: horizontal;
  spacing: 0.4em;
  children: [listview];
}

wrap {
	expand: false;
	orientation: vertical;
	children: [ inputbar, message ];
	border: 4px;
	border-radius: 10px;
	border-color: #ff6767;
	border-radius: 0.4em;
}

icon-ib {
	expand: false;
	filename: "system-search";
	vertical-align: 0.5;
	horizontal-align: 0.5;
	size: 1em;
}
inputbar {
	spacing: 0.4em;
	padding: 0.4em 0.8em;
	children: [ entry ];
}
entry {
	placeholder: "Search";
	placeholder-color: grey;
}
message {
	background-color: red/20%;
	border-color: lightsalmon;
	border: 3px 0px 0px 0px;
	padding: 10px;
	spacing: 10px;
}

listview {
	spacing: 10px;
}

element {
	orientation: vertical;
	padding: 0.1em;

	border-color: #454545;
	border: 4px;
	border-radius: 10px;

	children: [ element-text ];
}

element-text {
	horizontal-align: 0.5;
	vertical-align: 0.5;
	padding: 0.2em;
}

element selected {
	border-color: #ff6767;
	border: 4px;
	border-radius: 10px;
}

/**
 * Launching rofi with environment PREVIEW set to true
 * will split the screen and show a preview widget.
 */
@media ( enabled: env(PREVIEW, false)) {
  /** preview widget */
  icon-current-entry {
	border-color: #ff6767;
	border: 4px;
	border-radius: 10px;
    expand:          false;
    size:            70%;
  }
  listview-split {
    children: [listview, icon-current-entry];
  }
  listview {
	  lines: 4;
  }

}

@media ( enabled: env(NO_IMAGE, false)) {
	listview {
		columns: 1;
		spacing: 0.4em;
	}
	element {
		children: [ element-text ];
	}
	element-text {
		horizontal-align: 0.0;
	}
}
